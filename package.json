{
  "name": "bundle-cop",
  "version": "0.1.0",
  "private": true,
  "description": "Bundle Cop — Vercel Marketplace integration + Next.js adapter",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter bundle-cop-vercel-plugin build && next build",
    "start": "next start",
    "lint": "next lint",
    "build:plugin": "pnpm --filter bundle-cop-vercel-plugin build",
    "build:example": "pnpm --filter @bundle-cop/example build",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "bundle-cop-vercel-plugin": "workspace:*",
    "@vercel/blob": "^2.8.0",
    "@vercel/config": "^0.0.18",
    "next": "^16.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nad33mahm3d/bundle-cop-vercel-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/nad33mahm3d/bundle-cop-vercel-plugin/issues"
  },
  "homepage": "https://github.com/nad33mahm3d/bundle-cop-vercel-plugin#readme"
}
