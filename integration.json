{
  "slug": "bundle-cop",
  "name": "Bundle Cop",
  "description": "Prevent bundle regressions. Attribute cost to files and enforce budgets.",
  "supportEmail": "ebox.nadeem@gmail.com",
  "docsUrl": "https://bundle-cop.vercel.app/docs",
  "privacyPolicyUrl": "https://bundle-cop.vercel.app/privacy",
  "eulaUrl": "https://bundle-cop.vercel.app/eula",
  "scopes": [
    "deployment",
    "deployment-check",
    "project",
    "project-env-vars"
  ],
  "hooks": ["deployment.ready", "deployment.succeeded", "project.created"],
  "buildPlugins": ["bundle-cop-vercel-plugin"],
  "uiHooks": [
    { "path": "/setup", "type": "setup" },
    { "path": "/dashboard", "type": "dashboard" }
  ]
}
